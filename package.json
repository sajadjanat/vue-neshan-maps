{
  "name": "vue-neshan-maps",
  "version": "2.4.0",
  "description": "Typed Vue 3 Leaflet and MapLibre maps with Neshan live traffic and POI",
  "main": "./dist/vuejs-neshan-map-leaflet.cjs",
  "module": "./dist/vuejs-neshan-map-leaflet.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vuejs-neshan-map-leaflet.js",
      "require": "./dist/vuejs-neshan-map-leaflet.cjs"
    },
    "./style.css": "./dist/vuejs-neshan-map-leaflet.css",
    "./dist/style.css": "./dist/vuejs-neshan-map-leaflet.css",
    "./nuxt": {
      "types": "./nuxt/module.d.mts",
      "import": "./nuxt/module.mjs"
    },
    "./nuxt/plugin": {
      "types": "./nuxt/plugin.d.mts",
      "import": "./nuxt/plugin.mjs"
    },
    "./fonts/vazir.css": "./fonts/vazir.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-worker.mjs && vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:sdk": "vitest run --config vitest.sdk.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/prerender-site.mjs",
    "preview": "vite preview",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:nuxt": "node scripts/nuxt-smoke.mjs",
    "pack:legacy": "node scripts/pack-legacy.mjs",
    "test:legacy": "node scripts/test-legacy.mjs",
    "test:docs": "vitest run tests/docs.test.ts && vue-tsc -p work/docs-examples/tsconfig.json --noEmit",
    "test:site-seo": "node scripts/test-site-seo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajadjanat/vue-neshan-maps.git"
  },
  "keywords": [
    "neshan",
    "map",
    "vuejs",
    "vue",
    "leaflet",
    "maplibre",
    "vue3",
    "typescript",
    "traffic",
    "poi",
    "nuxt",
    "nuxt4"
  ],
  "author": "Sajad Abasi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sajadjanat/vue-neshan-maps/issues"
  },
  "homepage": "https://sajadjanat.github.io/vue-neshan-maps/",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^26.1.0",
    "marked": "^18.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.0.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.fa.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "nuxt",
    "fonts",
    "licenses"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.0",
    "dompurify": "^3.4.17",
    "maplibre-gl": "6.14.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  }
}
